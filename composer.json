{
	"name": "guave/assetload-bundle",
	"description": "Asset Load Helper and Insert Tags for Contao 5.0+",
	"license": "ISC",
	"type": "contao-bundle",
	"homepage": "https://www.guaveinteractive.ch",
	"support": {
		"issues": "https://github.com/guavestudios/assetloadbundle/issues",
		"source": "https://github.com/guavestudios/assetloadbundle"
	},
	"require": {
		"php": "^8.1",
		"ext-dom": "*",
		"ext-libxml": "*",
		"contao/core-bundle": "^5.3",
		"symfony/http-kernel": "^6.4 || ^7.4"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"contao/manager-plugin": "^2.3.1",
		"phpunit/phpunit": "^9.6",
		"roave/security-advisories": "dev-latest",
		"symfony/phpunit-bridge": "^6.4 || ^7.4"
	},
	"conflict": {
		"contao/manager-plugin": "<2.0 || >=3.0"
	},
	"autoload": {
		"psr-4": {
			"Guave\\AssetLoadBundle\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Guave\\AssetLoadBundle\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"contao-components/installer": true,
			"contao/manager-plugin": true,
			"php-http/discovery": false
		}
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": false,
			"target-directory": "tools",
			"forward-command": true
		},
		"contao-manager-plugin": "Guave\\AssetLoadBundle\\ContaoManager\\Plugin"
	},
	"scripts": {
		"all": [
			"@unit-tests",
			"@ecs",
			"@phpstan"
		],
		"ecs": "@php tools/ecs/vendor/bin/ecs check src tests --config ecs.php --fix --ansi",
		"phpstan": "@php tools/phpstan/vendor/bin/phpstan analyze --ansi",
		"unit-tests": "@php vendor/bin/phpunit --colors=always"
	}
}
